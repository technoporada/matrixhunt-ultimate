# 109 MB środowiska — nigdy do repo. Odtwarzalne: python3 -m venv .venv
.venv/
venv/

# Baza generowana przez aplikację (zawiera stan sesji i zapisane oferty)
*.db
*.sqlite
*.sqlite3
backend/matrixhunt.db
# Transientne pliki SQLite (WAL i shared memory). *.db je łapał, te dwa nie,
# więc trafiały do repo i pokazywały się jako usunięte po każdym otwarciu bazy.
*.db-shm
*.db-wal

# Pliki powstające w trakcie działania — te same, które sync.sh wyklucza
# z kopii lustrzanej. Bez tego wyciekłaby sesja i token.
.cookies
*.session
.session_secret
*.session_secret
*.app_settings.json
.vault_verifier
.filterlists
# Muzeum okazów: próbki ataków. Lokalne dane, nigdy do repo.
.specimens/

# Kopia usuniętego testu. W gitu nie ma sensu (to .bak), a lokalnie zostaje.
_testy_usuniete/

__pycache__/
*.pyc
.pytest_cache/
.coverage
.DS_Store

# frontend/vendor/ ZOSTAJE w repo: React i Babel są tam po to, żeby aplikacja
# działała offline. To świadoma decyzja, nie przypadek.
#
# frontend/offers.js to wynik tools/build_frontend.js (JSX -> JS). Trzymamy go
# w repo, żeby instalacja bez node działała od razu. Po zmianie offers.jsx
# uruchom: node tools/build_frontend.js
#
# frontend/vendor/ruffle/ (Ruffle 0.7.1 self-hosted, ~28 MB) też ZOSTAJE:
# /flash bez tego nie gra offline. Alternatywa to Git LFS, gdyby rosło.
#
# Roboczy dokument z notatkami sesji: lokalne sciezki i niedokonczone mysli.
CEL_NAPRAWCZY.md
